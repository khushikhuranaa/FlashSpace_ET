[TEMPLATE]
# ==================================================================
# FlashSpace environment template — copy each block into the file named
# above it. NEVER commit a real .env.
#
#   apps/api/.env   → the API (server secrets live ONLY here)
#   apps/web/.env   → the browser bundle (publishable values only)
# ==================================================================


# ==================================================================
# 1) apps/api/.env
# ==================================================================

# ---- Runtime ---------------------------------------------------------------
# Required by the current `loadEnv` production guards even when the app runs
# in Supabase mode. In production these must be strong and distinct.
LOCAL_AUTH_SECRET=change-me-in-local-dev
JOB_SECRET=change-me-job-secret

# Optional but common. PORT is often set by the host; default is 4000.
PORT=4000
NODE_ENV=development

# ---- Auth / repository / storage mode -------------------------------------
# AUTH_MODE: local | supabase
#   local     → the API owns sign-up/sign-in with its own JWT/session system
#   supabase  → Supabase Auth owns credential operations; the API only verifies
#               access tokens and mirrors profiles into its own database
AUTH_MODE=local

# Apply pending Postgres migrations during boot (Render-style single instance).
# The runner takes an advisory lock and is transactional + idempotent.
RUN_MIGRATIONS_ON_BOOT=false
# NODE_ENV=production refuses REPO_MODE=sqlite unless this is explicitly true.
ALLOW_SQLITE_IN_PRODUCTION=false

# REPO_MODE: memory | sqlite | postgres
#   memory   → tests and ephemeral demos
#   sqlite   → a real persistent local database file
#   postgres → Supabase PostgreSQL (or another Postgres) as the primary store
REPO_MODE=sqlite

# STORAGE_MODE: local | supabase
#   local    → files live on the container/app filesystem
#   supabase → files live in Supabase Storage so they survive redeploy/restarts
STORAGE_MODE=local

# ---- Supabase ---------------------------------------------------------------
# Required when AUTH_MODE=supabase. The anon/publishable key is public by
# design; RLS and the API decide what it may read or write. The service-role
# key must stay server-side only and must never appear in a VITE_ variable.
#
# Project Settings → API → Project URL
SUPABASE_URL=
# Project Settings → API → anon / publishable key
SUPABASE_ANON_KEY=
# Project Settings → API → service_role key. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Secret. Leave empty for projects that use
# asymmetric keys; the API then verifies sessions against the project JWKS.
SUPABASE_JWT_SECRET=

# ---- PostgreSQL -------------------------------------------------------------
# Session pooler URI + database password used by the PostgreSQL data layer and
# migration tooling. Required when REPO_MODE=postgres.
#
# Example pooler URI shape (replace project/region/password):
#   postgres://postgres.yourapp:password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Postgres pool sizing and timeouts, used by the PostgreSQL connection layer.
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000

# ---- Storage buckets --------------------------------------------------------
# Bucket names must match what exists in your Supabase project and in the
# Postgres RLS/storage policy files.
AVATARS_BUCKET=avatars
SUPABASE_FILES_BUCKET=space-files
SUPABASE_VAULT_BUCKET=vault-archives
SUPABASE_TEMP_BUCKET=archive-temp

# ---- Local storage and SQLite paths ----------------------------------------
# Used only when STORAGE_MODE=local or REPO_MODE=sqlite.
LOCAL_STORAGE_DIR=./data/local-storage
SQLITE_FILE=./data/flashspace.db

# ---- Signed storage URLs (local storage adapter) ---------------------------
# Base URL used to build signed storage URLs when the API serves local files.
SIGNED_URL_BASE=

# ---- Web origin / CORS -----------------------------------------------------
# Comma-separated list in production; "*" is allowed for local development
# only. WEB_ORIGIN must use https:// in production (validated by loadEnv).
WEB_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# ---- Reverse proxy ----------------------------------------------------------
# Number of trusted proxy hops in front of the API (for example 1 on Render/
# Fly/nginx). Leave empty/false when the API is directly exposed so that
# X-Forwarded-* headers cannot be spoofed.
TRUST_PROXY=

# ---- HTTPS / HSTS -----------------------------------------------------------
# Redirect plain HTTP to HTTPS. Defaults on when NODE_ENV=production.
REQUIRE_HTTPS=
# HSTS max-age in seconds (only sent on secure requests in production).
HSTS_MAX_AGE_SECONDS=15552000

# ---- Quotas / cost guardrails ----------------------------------------------
MAX_AVATAR_BYTES=2097152
FILE_MAX_BYTES=52428800
SPACE_MAX_BYTES=262144000
MAX_ACTIVE_SPACES_PER_USER=20

# ---- Lifecycle tuning -------------------------------------------------------
WARNING_WINDOW_HOURS=24
MAX_EXTENSION_DAYS=14
EXTENSION_POLICY=ADMIN

# ---- Upload filtering -------------------------------------------------------
# Comma-separated extensions rejected at upload time (executables, installers,
# scripts, and similar). Blank or missing falls back to a compiled default list.
UPLOAD_BLOCKED_EXTENSIONS=

# ---- Email delivery (transactional + lifecycle notifications) --------------
# emailTransport controls the default email sender path:
#   mock  → built-in dev preview only, never delivers real email
#   smtp  → send through the SMTP block below
#   null  → no email sending configured
EMAIL_TRANSPORT=mock

# SMTP settings (used when EMAIL_TRANSPORT=smtp).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=flashspace@localhost

# Secure TLS mode for SMTP.
SMTP_SECURE=false
# Optional SNI hostname for SMTP TLS (set when the hostname differs from the
# connection target).
SMTP_TLS_SERVERNAME=

# Sender identity used for outbound email.
EMAIL_FROM=flashspace@flashspace.local
EMAIL_FROM_NAME=FlashSpace

# Email timing and retry tolerances.
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_DELIVERY_TIMEOUT_MS=30000
EMAIL_VERIFICATION_EXPIRY_MS=86400000
EMAIL_RESET_EXPIRY_MS=3600000
EMAIL_INVITATION_EXPIRY_MS=604800000
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY_MS=5000
EMAIL_RETRY_MAX_DELAY_MS=300000

# Feature flags for email flows. In Supabase mode these usually stay on because
# Supabase sends verification/recovery mail, but the app still exposes the
# endpoints so clients do not have to branch on provider.
EMAIL_VERIFICATION_MODE=true
PASSWORD_RESET_MODE=true

# ---- Local backups ----------------------------------------------------------
BACKUP_DIR=./data/backups
BACKUP_RETENTION=7

# ---- Rate limiting ----------------------------------------------------------
# Enable general per-IP rate limiting. Auth, upload, expensive and invite paths
# have their own budgets once this is on.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_EXPENSIVE_MAX=30
RATE_LIMIT_INVITE_MAX=30

# ---- Malware scanning --------------------------------------------------------
# Provider-independent scanning policy. Only "off" is fully unconfigured by
# default; "advisory" and "enforce" keep working under the documented policy.
MALWARE_SCAN_POLICY=advisory
MALWARE_SCAN_MAX_BYTES=26214400


# ==================================================================
# 2) apps/web/.env
# ==================================================================
# These are bundled into the frontend. Only publishable configuration belongs
# here. NEVER put the service_role key in a VITE_ variable.

# Leave empty to use the Vite dev proxy (/api -> localhost:4000).
VITE_API_URL=

# Must match AUTH_MODE on the API: local | supabase.
# Keep `local` for a fresh checkout: the API defaults to AUTH_MODE=local, and a
# mismatch makes the browser expect Supabase sessions the API never issues.
VITE_AUTH_MODE=local

# Project Settings → API → Project URL + anon/publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
