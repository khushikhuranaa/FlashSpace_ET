# ------------------------------------------------------------------
# FlashSpace environment — copy to apps/api/.env and apps/web/.env
# NEVER commit real .env files. Placeholders only here.
# ------------------------------------------------------------------

# ---- API (apps/api/.env) ----
PORT=4000
NODE_ENV=development

# AUTH_MODE: "local" (zero-config demo auth) | "supabase" (Supabase Auth JWTs)
AUTH_MODE=local

# Supabase (required when AUTH_MODE=supabase, or for DB/storage Supabase adapters)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-key
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres

# Repository / storage adapters (local ones need no cloud account)
# REPO_MODE: memory | postgres
REPO_MODE=memory
# STORAGE_MODE: local | supabase
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./data/local-storage

# Secret used to sign local auth tokens and local storage signed URLs
LOCAL_AUTH_SECRET=change-me-in-local-dev
# Secret required by /api/internal/* job endpoints (X-Job-Secret header)
JOB_SECRET=change-me-job-secret

# Quotas (hard cost guardrails)
FILE_MAX_BYTES=52428800        # 50 MB per file
SPACE_MAX_BYTES=262144000      # 250 MB per Space
MAX_ACTIVE_SPACES_PER_USER=20

# Lifecycle tuning
WARNING_WINDOW_HOURS=24        # how long before expiry the WARNING state fires
MAX_EXTENSION_DAYS=14
EXTENSION_POLICY=ADMIN         # ADMIN | AUTO

# Optional SMTP notifications (works locally via Mailpit from docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=flashspace@localhost

# ---- Web (apps/web/.env) ----
# Leave empty to use the Vite dev proxy (/api -> localhost:4000)
VITE_API_URL=
# local | supabase (must match API AUTH_MODE)
VITE_AUTH_MODE=local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
